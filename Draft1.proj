############################################################
# Bayesian Causal Forest (BCF) Pipeline 
############################################################


install.packages("Rcpp", type = "source")

install.packages("RcppParallel", type = "source")

install.packages("bcf", type = "source")

#############################
# 1. Packages
#############################

pkgs <- c(
  "mice", "bcf", "dplyr", "purrr", "ggplot2",
  "rpart", "rpart.plot", "posterior",
  "tidyr", "readxl"
)

to_install <- pkgs[!pkgs %in% rownames(installed.packages())]

if(length(to_install)) {
  install.packages(to_install)
}

invisible(lapply(pkgs, library, character.only = TRUE))

set.seed(2026)

#############################
# 2. Load Data
#############################

df_main <- read_excel("Nikki Smith R01 Subset (1).xls")

df_add <- read_excel(
  "PSmith R01 additional data (1).xlsx"
)

#############################
# 3. Merge Data
#############################

# Check common columns
common_cols <- intersect(names(df_main), names(df_add))

print(common_cols)

# Replace with your actual ID variable if needed
id_var <- common_cols[1]

df <- left_join(df_main, df_add, by = id_var)

#############################
# 4. Define Variables
#############################

outcome <- "Y"
treat   <- "Z"

covars <- setdiff(names(df), c(outcome, treat))

#############################
# 5. Inspect Data
#############################

glimpse(df)


#####################################################################


#############################
# 6. Multiple Imputation (MICE)
#############################

ini <- mice(df, maxit = 0)

meth <- ini$method
meth[meth != ""] <- "pmm"

pred_mat <- ini$predictorMatrix
diag(pred_mat) <- 0

imp <- mice(
  df,
  m = 5,
  method = meth,
  predictorMatrix = pred_mat,
  maxit = 20,
  seed = 2026
)

imp_list <- lapply(seq_len(imp$m), complete, data = imp)

# Check imputed structure
dplyr::glimpse(imp_list[[1]])

# Ensure BCF-safe formats
imp_list <- lapply(imp_list, function(dat) {
  dat <- dplyr::mutate(dat, dplyr::across(where(is.character), as.factor))
  dat <- dplyr::mutate(dat, dplyr::across(where(is.factor), as.integer))
  dat
})

dplyr::glimpse(imp_list[[1]])

#############################
# 7. BCF parameter sets
#############################

bcf_primary <- list(
  ntree_control = 200,
  base_control  = 0.95,
  power_control = 2,
  ntree_moderate = 50,
  base_moderate  = 0.25,
  power_moderate = 3
)

bcf_sensitivity <- list(
  ntree_control = 200,
  base_control  = 0.95,
  power_control = 2,
  ntree_moderate = 200,
  base_moderate  = 0.95,
  power_moderate = 2
)

#############################
# 8. BCF fit function
#############################

fit_bcf <- function(data, pars,
                    outcome, treat, covars,
                    nburn = 2000, nsim = 5000) {
  
  y <- data[[outcome]]
  z <- data[[treat]]
  X <- as.matrix(dplyr::select(data, dplyr::all_of(covars)))
  
  pihat <- rep(mean(z, na.rm = TRUE), nrow(data))
  
  bcf(
    y = y,
    z = z,
    x_control = X,
    x_moderate = X,
    pihat = pihat,
    nburn = nburn,
    nsim = nsim,
    ntree_control = pars$ntree_control,
    base_control = pars$base_control,
    power_control = pars$power_control,
    ntree_moderate = pars$ntree_moderate,
    base_moderate = pars$base_moderate,
    power_moderate = pars$power_moderate
  )
}

fit_all_imputations <- function(imp_list, pars) {
  lapply(imp_list, fit_bcf,
         pars = pars,
         outcome = outcome,
         treat = treat,
         covars = covars)
}

#############################
# 9. Fit BCF models
#############################

bcf_primary_models <- fit_all_imputations(imp_list, bcf_primary)

# Check model object
str(bcf_primary_models[[1]])

bcf_sensitivity_models <- fit_all_imputations(imp_list, bcf_sensitivity)

#############################
# 10. Extract posterior tau
#############################

extract_tau <- function(fit) fit$tau

tau_list <- lapply(bcf_primary_models, extract_tau)
pooled_tau <- do.call(rbind, tau_list)

# Check tau matrix
dim(pooled_tau)
dplyr::glimpse(as.data.frame(pooled_tau[, 1:5]))

#############################
# 11. Overall treatment effect (ATE)
#############################

ate_draws <- rowMeans(pooled_tau)

overall_ate <- mean(ate_draws)
ate_ci <- quantile(ate_draws, c(0.025, 0.975))
p_gt_zero <- mean(ate_draws > 0)

cat("\nATE:", overall_ate, "\n")
print(ate_ci)
cat("\nP(ATE > 0):", p_gt_zero, "\n")

#############################
# 12. Subject-level CATE
#############################

cate <- colMeans(pooled_tau)

# Check CATE structure
dplyr::glimpse(data.frame(cate = cate))

#############################
# 13. Subgroup function
#############################

subgroup_effect <- function(idx, label1, label2) {
  
  if(length(idx[[1]]) == 0 || length(idx[[2]]) == 0) {
    stop("Empty subgroup detected — check coding.")
  }
  
  g1 <- apply(pooled_tau[, idx[[1]], drop = FALSE], 1, mean)
  g2 <- apply(pooled_tau[, idx[[2]], drop = FALSE], 1, mean)
  
  diff <- g1 - g2
  
  tibble::tibble(
    group1 = label1,
    group2 = label2,
    mean = mean(diff),
    lo = quantile(diff, 0.025),
    hi = quantile(diff, 0.975),
    p_gt_0 = mean(diff > 0)
  )
}

#############################
# 14. Subgroup analyses
#############################

analysis_df <- imp_list[[1]]

dplyr::glimpse(analysis_df)

# Sex subgroup
sex_idx <- list(
  male = which(analysis_df$sex == "Male"),
  female = which(analysis_df$sex == "Female")
)

sex_res <- subgroup_effect(sex_idx, "Male", "Female")

# Age subgroup
age_idx <- list(
  young = which(analysis_df$age < 60),
  old   = which(analysis_df$age >= 60)
)

age_res <- subgroup_effect(age_idx, "<60", ">=60")

#############################
# 15. Density plot
#############################

plot_df <- tibble::tibble(
  male = apply(pooled_tau[, sex_idx$male, drop = FALSE], 1, mean),
  female = apply(pooled_tau[, sex_idx$female, drop = FALSE], 1, mean)
)

dplyr::glimpse(plot_df)

plot_df <- tidyr::pivot_longer(
  plot_df,
  cols = everything(),
  names_to = "group",
  values_to = "value"
)

ggplot2::ggplot(plot_df, ggplot2::aes(value, fill = group)) +
  ggplot2::geom_density(alpha = 0.4) +
  ggplot2::theme_bw()

#############################
# 16. CART for subgroup discovery
#############################

cart_df <- analysis_df
cart_df$cate <- cate

dplyr::glimpse(cart_df)

form <- as.formula(
  paste("cate ~", paste(covars, collapse = " + "))
)

cart_fit <- rpart::rpart(
  form,
  data = cart_df,
  method = "anova",
  control = rpart.control(
    cp = 0.01,
    minbucket = 20,
    maxdepth = 3
  )
)

rpart.plot::rpart.plot(cart_fit, type = 3, extra = 101)

#############################
# 17. Terminal node effects
#############################

nodes <- cart_fit$where
cart_df$node <- nodes

dplyr::glimpse(cart_df)

node_results <- lapply(unique(nodes), function(n) {
  
  idx <- which(nodes == n)
  
  draw <- apply(pooled_tau[, idx, drop = FALSE], 1, mean)
  
  tibble::tibble(
    node = n,
    mean = mean(draw),
    lo = quantile(draw, 0.025),
    hi = quantile(draw, 0.975),
    p_gt_0 = mean(draw > 0)
  )
}) %>% dplyr::bind_rows()

#############################
# 18. Save results
#############################

write.csv(node_results, "subgroup_results.csv", row.names = FALSE)

saveRDS(bcf_primary_models, "bcf_models.rds")
saveRDS(pooled_tau, "pooled_tau.rds")
