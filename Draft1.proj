############################################################
# Bayesian Causal Forest (BCF) Pipeline 
############################################################


install.packages("Rcpp", type = "source")

install.packages("RcppParallel", type = "source")

install.packages("bcf", type = "source")

#############################
# 1. Packages
#############################

pkgs <- c(
  "mice", "bcf", "dplyr", "purrr", "ggplot2",
  "rpart", "rpart.plot", "posterior",
  "tidyr", "readxl"
)

to_install <- pkgs[!pkgs %in% rownames(installed.packages())]

if(length(to_install)) {
  install.packages(to_install)
}

invisible(lapply(pkgs, library, character.only = TRUE))

set.seed(2026)

#############################
# 2. Load Data
#############################

df_main <- read_excel("Nikki Smith R01 Subset (1).xls")

df_add <- read_excel(
  "PSmith R01 additional data (1).xlsx"
)



#############################
# 3. Merge Data
#############################

# Check common columns
common_cols <- intersect(
  names(df_main),
  names(df_add)
)

print(common_cols)

# Merge using first common column
# (replace if another ID is correct)

id_var <- common_cols[1]

df <- left_join(
  df_main,
  df_add,
  by = id_var
)

#############################
# 4. Data Cleaning
#############################

# Remove ID variable

df <- df %>%
  select(-SUBID)

#############################
# Convert character numeric
# variables with "." to NA
#############################

char_numeric_vars <- c(
  "homadiff",
  "bhitoidiff",
  "bhio2diff",
  "vmro2diff",
  "vmrtoidiff",
  "nirscogdiff",
  "nirso2diff",
  "nirstoidiff",
  "veldiff",
  "flowdiff"
)

df <- df %>%
  mutate(
    across(
      all_of(char_numeric_vars),
      ~ na_if(., ".")
    )
  )

df <- df %>%
  mutate(
    across(
      all_of(char_numeric_vars),
      as.numeric
    )
  )

#############################
# Remove duplicate sex vars
#############################

df <- df %>%
  select(
    -male.y,
    -Gender
  )

#############################
# 5. Define Variables
#############################

# Treatment:
# SEPA = 0
# C-LIFE = 1

df$z <- ifelse(
  df$group == "C-LIFE",
  1,
  0
)

#############################
# Outcome variables
#############################

df$exec_change <- (
  df$pjexect2r -
    df$pjexect1r
)

df$mem_change <- (
  df$memt2r -
    df$memt1r
)

df$speed_change <- (
  df$speedt2r -
    df$speedt1r
)

#############################
# Covariates
#############################

covars <- c(
  
  # demographics
  "Age",
  "male.x",
  "minority",
  "eduyrs",
  
  # baseline cognition
  "speedt1r",
  "memt1r",
  "pjexect1r",
  
  # blood pressure
  "clinicdbpt1",
  "clinicsbpt1",
  "MeanSys24hrT1",
  "MeanDia24hrT1",
  
  # fitness
  "avgstepst1",
  "pkvo2t1",
  
  # metabolic
  "Glucose",
  "Insulin",
  "HbA1C",
  
  # lipids
  "totChol",
  "Trigly",
  "HDL",
  "LDL",
  
  # vascular
  "fmdt1",
  "fart1",
  
  # adiposity
  "wthrt1",
  
  # metabolic syndrome
  "metsynst1"
)

#############################
# 6. Inspect Data
#############################

glimpse(df)

#############################
# 7. Multiple Imputation
#############################

ini <- mice(
  df,
  maxit = 0
)

meth <- ini$method

#############################
# Use predictive mean matching
# for continuous variables
#############################

meth[meth != ""] <- "pmm"

#############################
# Predictor matrix
#############################

pred <- ini$predictorMatrix

diag(pred) <- 0

#############################
# Run MICE
#############################

imp <- mice(
  df,
  m = 5,
  method = meth,
  predictorMatrix = pred,
  maxit = 20,
  seed = 2026
)

#############################
# Create completed datasets
#############################

imp_list <- lapply(
  seq_len(imp$m),
  complete,
  data = imp
)

#############################
# Clean imputed datasets
#############################

imp_list <- lapply(
  imp_list,
  function(dat) {
    
    dat <- dat %>%
      mutate(
        across(
          where(is.character),
          as.factor
        )
      )
    
    dat
  }
)

#############################
# 8. BCF Parameter Sets
#############################

# Primary analysis prior

primary_pars <- list(
  ntree_control = 200,
  base_control = 0.95,
  power_control = 2,
  ntree_moderate = 50,
  base_moderate = 0.25,
  power_moderate = 3
)

# Sensitivity analysis prior

sensitivity_pars <- list(
  ntree_control = 200,
  base_control = 0.95,
  power_control = 2,
  ntree_moderate = 200,
  base_moderate = 0.95,
  power_moderate = 2
)

#############################
# 9. Generic BCF Function
#############################

fit_bcf <- function(
    data,
    outcome_var,
    pars,
    nburn = 2000,
    nsim = 5000
) {
  
  #############################
  # Outcome
  #############################
  
  y <- as.numeric(
    data[[outcome_var]]
  )
  
  #############################
  # Treatment
  #############################
  
  z <- as.numeric(
    data$z
  )
  
  #############################
  # Covariates
  #############################
  
  X <- data[, covars]
  
  #############################
  # Convert factors/logicals
  #############################
  
  X <- X %>%
    mutate(
      across(
        where(is.factor),
        as.numeric
      ),
      across(
        where(is.logical),
        as.numeric
      )
    )
  
  #############################
  # Convert to matrix
  #############################
  
  X <- as.matrix(X)
  
  #############################
  # Keep complete cases
  #############################
  
  keep <- complete.cases(
    y,
    z,
    X
  )
  
  y <- y[keep]
  
  z <- z[keep]
  
  X <- X[keep, ]
  
  #############################
  # Diagnostics
  #############################
  
  cat("\nDiagnostics\n")
  
  cat(
    "Outcome:",
    outcome_var,
    "\n"
  )
  
  cat(
    "N:",
    length(y),
    "\n"
  )
  
  cat(
    "Treated:",
    sum(z == 1),
    "\n"
  )
  
  cat(
    "Control:",
    sum(z == 0),
    "\n"
  )
  
  #############################
  # Propensity scores
  #############################
  
  # Randomized trial:
  # use empirical treatment prob
  
  pihat <- rep(
    mean(z),
    length(z)
  )
  
  #############################
  # Fit BCF
  #############################
  
  fit <- bcf(
    y = y,
    z = z,
    x_control = X,
    x_moderate = X,
    pihat = pihat,
    nburn = nburn,
    nsim = nsim,
    ntree_control = pars$ntree_control,
    base_control = pars$base_control,
    power_control = pars$power_control,
    ntree_moderate = pars$ntree_moderate,
    base_moderate = pars$base_moderate,
    power_moderate = pars$power_moderate
  )
  
  return(fit)
}

#############################
# 10. Run Across Imputations
#############################

fit_all_imputations <- function(
    outcome_var,
    pars
) {
  
  models <- lapply(
    
    imp_list,
    
    function(dat) {
      
      tryCatch({
        
        fit_bcf(
          data = dat,
          outcome_var = outcome_var,
          pars = pars
        )
        
      }, error = function(e) {
        
        print(e)
        
        return(NULL)
      })
    }
  )
  
  #############################
  # Remove failed fits
  #############################
  
  models <- Filter(
    Negate(is.null),
    models
  )
  
  return(models)
}

#############################
# 11. Primary Analysis
#############################

bcf_exec_models <- fit_all_imputations(
  outcome_var = "exec_change",
  pars = primary_pars
)

#############################
# 12. Extract Posterior Tau
#############################

extract_tau <- function(fit) {
  
  tau <- fit$tauhats
  
  tau <- as.matrix(tau)
  
  return(tau)
}

tau_list <- lapply(
  bcf_exec_models,
  extract_tau
)

#############################
# Pool posterior draws
#############################

pooled_tau <- do.call(
  rbind,
  tau_list
)

#############################
# Inspect pooled tau
#############################

dim(pooled_tau)

glimpse(
  as.data.frame(
    pooled_tau[, 1:5]
  )
)

#############################
# 13. Overall ATE
#############################

# One ATE per posterior draw

ate_draws <- rowMeans(
  pooled_tau
)

#############################
# Posterior summaries
#############################

overall_ate <- mean(
  ate_draws
)

ate_ci <- quantile(
  ate_draws,
  probs = c(0.025, 0.975)
)

p_gt_zero <- mean(
  ate_draws > 0
)

#############################
# Print results
#############################

cat("\nOverall ATE\n")

print(overall_ate)

cat("\n95% Credible Interval\n")

print(ate_ci)

cat("\nP(ATE > 0)\n")

print(p_gt_zero)

#############################
# 14. Subject-level CATE
#############################

cate <- colMeans(
  pooled_tau
)

analysis_df <- imp_list[[1]]

analysis_df$cate <- cate

#############################
# 15. Pre-specified Subgroups
#############################

subgroup_effect <- function(
    idx1,
    idx2
) {
  
  g1 <- rowMeans(
    pooled_tau[, idx1, drop = FALSE]
  )
  
  g2 <- rowMeans(
    pooled_tau[, idx2, drop = FALSE]
  )
  
  diff <- g1 - g2
  
  tibble(
    mean = mean(diff),
    lo = quantile(diff, 0.025),
    hi = quantile(diff, 0.975),
    p_gt_0 = mean(diff > 0)
  )
}

#############################
# Sex subgroup
#############################

sex_idx <- list(
  male = which(
    analysis_df$male.x == 1
  ),
  female = which(
    analysis_df$male.x == 0
  )
)

sex_results <- subgroup_effect(
  sex_idx$male,
  sex_idx$female
)

print(sex_results)

#############################
# Age subgroup
#############################

age_idx <- list(
  lt60 = which(
    analysis_df$Age < 60
  ),
  ge60 = which(
    analysis_df$Age >= 60
  )
)

age_results <- subgroup_effect(
  age_idx$lt60,
  age_idx$ge60
)

print(age_results)

#############################
# 16. Density Plot
#############################

plot_df <- tibble(
  
  male = rowMeans(
    pooled_tau[
      ,
      sex_idx$male,
      drop = FALSE
    ]
  ),
  
  female = rowMeans(
    pooled_tau[
      ,
      sex_idx$female,
      drop = FALSE
    ]
  )
)

plot_df <- pivot_longer(
  plot_df,
  cols = everything(),
  names_to = "group",
  values_to = "value"
)

ggplot(
  plot_df,
  aes(
    x = value,
    fill = group
  )
) +
  geom_density(alpha = 0.4) +
  theme_bw()

#############################
# 17. CART Subgroup Discovery
#############################

cart_formula <- as.formula(
  paste(
    "cate ~",
    paste(covars, collapse = " + ")
  )
)

cart_fit <- rpart(
  cart_formula,
  data = analysis_df,
  method = "anova",
  control = rpart.control(
    cp = 0.01,
    minbucket = 20,
    maxdepth = 3
  )
)

rpart.plot(
  cart_fit,
  type = 3,
  extra = 101
)

#############################
# 18. Terminal Node Effects
#############################

nodes <- cart_fit$where

analysis_df$node <- nodes

node_results <- lapply(
  
  unique(nodes),
  
  function(n) {
    
    idx <- which(
      nodes == n
    )
    
    draw <- rowMeans(
      pooled_tau[
        ,
        idx,
        drop = FALSE
      ]
    )
    
    tibble(
      node = n,
      mean = mean(draw),
      lo = quantile(draw, 0.025),
      hi = quantile(draw, 0.975),
      p_gt_0 = mean(draw > 0)
    )
  }
  
) %>%
  
  bind_rows()

print(node_results)

#############################
# 19. Save Results
#############################

write.csv(
  node_results,
  "subgroup_results.csv",
  row.names = FALSE
)

saveRDS(
  bcf_exec_models,
  "bcf_exec_models.rds"
)

saveRDS(
  pooled_tau,
  "pooled_tau.rds"
)


#vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv

#############################
# 3. Merge Data
#############################

# Check common columns
common_cols <- intersect(names(df_main), names(df_add))

print(common_cols)

# Replace with your actual ID variable if needed
id_var <- common_cols[1]

df <- left_join(df_main, df_add, by = id_var)

#############################
# 4. Define Variables
#############################

outcome <- "Y"
treat   <- "Z"

covars <- setdiff(names(df), c(outcome, treat))

#############################
# 5. Inspect Data
#############################

glimpse(df)


#####################################################################


#############################
# 6. Multiple Imputation (MICE)
#############################

ini <- mice(df, maxit = 0)

meth <- ini$method
meth[meth != ""] <- "pmm"

pred_mat <- ini$predictorMatrix
diag(pred_mat) <- 0

imp <- mice(
  df,
  m = 5,
  method = meth,
  predictorMatrix = pred_mat,
  maxit = 20,
  seed = 2026
)

imp_list <- lapply(seq_len(imp$m), complete, data = imp)

# Ensure BCF-safe formats
imp_list <- lapply(imp_list, function(dat) {
  dat <- dplyr::mutate(dat, dplyr::across(where(is.character), as.factor))
  dat <- dplyr::mutate(dat, dplyr::across(where(is.factor), as.integer))
  dat
})

#############################
# 7. BCF parameter sets
#############################

bcf_primary <- list(
  ntree_control = 200,
  base_control  = 0.95,
  power_control = 2,
  ntree_moderate = 50,
  base_moderate  = 0.25,
  power_moderate = 3
)

bcf_sensitivity <- list(
  ntree_control = 200,
  base_control  = 0.95,
  power_control = 2,
  ntree_moderate = 200,
  base_moderate  = 0.95,
  power_moderate = 2
)

#############################
# 8. BCF fit function
#############################

fit_bcf <- function(data, pars,
                    outcome, treat, covars,
                    nburn = 2000, nsim = 5000) {
  
  y <- data[[outcome]]
  z <- data[[treat]]
  X <- as.matrix(dplyr::select(data, dplyr::all_of(covars)))
  
  pihat <- rep(mean(z, na.rm = TRUE), nrow(data))
  
  bcf(
    y = y,
    z = z,
    x_control = X,
    x_moderate = X,
    pihat = pihat,
    nburn = nburn,
    nsim = nsim,
    ntree_control = pars$ntree_control,
    base_control = pars$base_control,
    power_control = pars$power_control,
    ntree_moderate = pars$ntree_moderate,
    base_moderate = pars$base_moderate,
    power_moderate = pars$power_moderate
  )
}

fit_all_imputations <- function(imp_list, pars) {
  lapply(imp_list, fit_bcf,
         pars = pars,
         outcome = outcome,
         treat = treat,
         covars = covars)
}

#############################
# 9. Fit BCF models
#############################

# Primary outcome:
# Executive function change score
# (post-treatment minus baseline)

bcf_primary <- function(data) {
  
  #############################
  # Outcome
  #############################
  
  y <- as.numeric(
    data$pjexect2r - data$pjexect1r
  )
  
  #############################
  # Treatment assignment
  #############################
  
  # SEPA   = 0
  # C-LIFE = 1
  
  z <- ifelse(
    data$group == "C-LIFE",
    1,
    0
  )
  
  z <- as.numeric(z)
  
  #############################
  # Covariates
  #############################
  
  X <- data[, c(
    "Age",
    "male.x"
  )]
  
  #############################
  # Clean covariates
  #############################
  
  X <- data.frame(
    lapply(X, function(x) {
      
      if (is.factor(x) || is.logical(x)) {
        
        as.numeric(as.factor(x))
        
      } else {
        
        as.numeric(x)
      }
    })
  )
  
  #############################
  # Remove incomplete rows
  #############################
  
  keep <- complete.cases(y, z, X)
  
  y <- y[keep]
  z <- z[keep]
  X <- X[keep, ]
  
  #############################
  # Convert to matrix
  #############################
  
  X <- as.matrix(X)
  
  #############################
  # Diagnostics
  #############################
  
  cat("\nModel diagnostics:\n")
  cat("length(y):", length(y), "\n")
  cat("length(z):", length(z), "\n")
  cat("nrow(X):", nrow(X), "\n")
  
  #############################
  # Propensity scores
  #############################
  
  # Since this is a randomized trial,
  # use empirical treatment probability
  
  pihat <- rep(
    mean(z),
    length(z)
  )
  
  #############################
  # Fit Bayesian Causal Forest
  #############################
  
  fit <- bcf(
    y = y,
    z = z,
    x_control = X,
    x_moderate = X,
    pihat = pihat
  )
  
  return(fit)
}

#############################
# Run BCF across imputations
#############################

bcf_primary_models <- lapply(
  imp_list,
  function(dat) {
    
    tryCatch({
      
      fit <- bcf_primary(dat)
      
      cat("Model fit successful\n")
      
      return(fit)
      
    }, error = function(e) {
      
      cat("Model failed:\n")
      print(e)
      
      return(NULL)
    })
  }
)

#############################
# Remove failed models
#############################

bcf_primary_models <- Filter(
  Negate(is.null),
  bcf_primary_models
)

#############################
# Check number of successful fits
#############################

cat(
  "\nSuccessful models:",
  length(bcf_primary_models),
  "\n"
)

#############################
# 10. Extract posterior tau draws
#############################

extract_tau <- function(fit) {
  
  # Check model exists
  if (is.null(fit)) {
    return(NULL)
  }
  
  # Check tau exists
  if (is.null(fit$tau)) {
    stop("tau not found in BCF model object")
  }
  
  tau <- fit$tau
  
  # Ensure matrix format
  tau <- as.matrix(tau)
  
  return(tau)
}

# Extract tau from all successful models
tau_list <- lapply(bcf_primary_models, extract_tau)

# Remove failed/null fits
tau_list <- tau_list[!sapply(tau_list, is.null)]

# Check dimensions
lapply(tau_list, dim)

# Combine posterior draws across imputations
pooled_tau <- do.call(rbind, tau_list)

# Inspect
dim(pooled_tau)

dplyr::glimpse(
  as.data.frame(
    pooled_tau[, 1:min(5, ncol(pooled_tau))]
  )
)

#############################
# 11. Overall treatment effect (ATE)
#############################

# Average treatment effect for each posterior draw
ate_draws <- rowMeans(pooled_tau, na.rm = TRUE)

# Posterior mean ATE
overall_ate <- mean(ate_draws, na.rm = TRUE)

# 95% credible interval
ate_ci <- quantile(
  ate_draws,
  probs = c(0.025, 0.975),
  na.rm = TRUE
)

# Posterior probability ATE > 0
p_gt_zero <- mean(ate_draws > 0, na.rm = TRUE)

# Results
cat("\nATE:", overall_ate, "\n")

cat("\n95% Credible Interval:\n")
print(ate_ci)

cat("\nP(ATE > 0):", p_gt_zero, "\n")

#############################
# 12. Subject-level CATE
#############################

cate <- colMeans(pooled_tau)

# Check CATE structure
dplyr::glimpse(data.frame(cate = cate))

#############################
# 13. Subgroup function
#############################

subgroup_effect <- function(idx, label1, label2) {
  
  if(length(idx[[1]]) == 0 || length(idx[[2]]) == 0) {
    stop("Empty subgroup detected — check coding.")
  }
  
  g1 <- apply(pooled_tau[, idx[[1]], drop = FALSE], 1, mean)
  g2 <- apply(pooled_tau[, idx[[2]], drop = FALSE], 1, mean)
  
  diff <- g1 - g2
  
  tibble::tibble(
    group1 = label1,
    group2 = label2,
    mean = mean(diff),
    lo = quantile(diff, 0.025),
    hi = quantile(diff, 0.975),
    p_gt_0 = mean(diff > 0)
  )
}

#############################
# 14. Subgroup analyses
#############################

analysis_df <- imp_list[[1]]

dplyr::glimpse(analysis_df)

# Sex subgroup
sex_idx <- list(
  male = which(analysis_df$sex == "Male"),
  female = which(analysis_df$sex == "Female")
)

sex_res <- subgroup_effect(sex_idx, "Male", "Female")

# Age subgroup
age_idx <- list(
  young = which(analysis_df$age < 60),
  old   = which(analysis_df$age >= 60)
)

age_res <- subgroup_effect(age_idx, "<60", ">=60")

#############################
# 15. Density plot
#############################

plot_df <- tibble::tibble(
  male = apply(pooled_tau[, sex_idx$male, drop = FALSE], 1, mean),
  female = apply(pooled_tau[, sex_idx$female, drop = FALSE], 1, mean)
)

dplyr::glimpse(plot_df)

plot_df <- tidyr::pivot_longer(
  plot_df,
  cols = everything(),
  names_to = "group",
  values_to = "value"
)

ggplot2::ggplot(plot_df, ggplot2::aes(value, fill = group)) +
  ggplot2::geom_density(alpha = 0.4) +
  ggplot2::theme_bw()

#############################
# 16. CART for subgroup discovery
#############################

cart_df <- analysis_df
cart_df$cate <- cate

dplyr::glimpse(cart_df)

form <- as.formula(
  paste("cate ~", paste(covars, collapse = " + "))
)

cart_fit <- rpart::rpart(
  form,
  data = cart_df,
  method = "anova",
  control = rpart.control(
    cp = 0.01,
    minbucket = 20,
    maxdepth = 3
  )
)

rpart.plot::rpart.plot(cart_fit, type = 3, extra = 101)

#############################
# 17. Terminal node effects
#############################

nodes <- cart_fit$where
cart_df$node <- nodes

dplyr::glimpse(cart_df)

node_results <- lapply(unique(nodes), function(n) {
  
  idx <- which(nodes == n)
  
  draw <- apply(pooled_tau[, idx, drop = FALSE], 1, mean)
  
  tibble::tibble(
    node = n,
    mean = mean(draw),
    lo = quantile(draw, 0.025),
    hi = quantile(draw, 0.975),
    p_gt_0 = mean(draw > 0)
  )
}) %>% dplyr::bind_rows()

#############################
# 18. Save results
#############################

write.csv(node_results, "subgroup_results.csv", row.names = FALSE)

saveRDS(bcf_primary_models, "bcf_models.rds")
saveRDS(pooled_tau, "pooled_tau.rds")







