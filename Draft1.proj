############################################################
# Bayesian Causal Forest (BCF) Pipeline 
############################################################

#############################
# 1. Packages
#############################

pkgs <- c("mice","bcf","dplyr","purrr","ggplot2",
          "rpart","rpart.plot","posterior","tidyr","readxl")

to_install <- pkgs[!pkgs %in% rownames(installed.packages())]
if(length(to_install)) install.packages(to_install)

invisible(lapply(pkgs, library, character.only = TRUE))

set.seed(2026)

#############################
# 2. Load Data
#############################

url <- "https://duke.app.box.com/file/2053650404707?download=1"

tmp_file <- tempfile(fileext = ".xlsx")
download.file(url, tmp_file, mode = "wb")

df <- read_excel(tmp_file)

outcome <- "Y"
treat   <- "Z"

covars <- setdiff(names(df), c(outcome, treat))

#############################
# 3. Multiple Imputation (MICE)
#############################

ini <- mice(df, maxit = 0)

meth <- ini$method
meth[meth != ""] <- "pmm"

pred_mat <- ini$predictorMatrix
diag(pred_mat) <- 0

imp <- mice(
  df,
  m = 5,
  method = meth,
  predictorMatrix = pred_mat,
  maxit = 20,
  seed = 2026
)

imp_list <- lapply(seq_len(imp$m), complete, data = imp)

#############################
# 4. BCF parameter sets
#############################

bcf_primary <- list(
  ntree_control = 200,
  base_control  = 0.95,
  power_control = 2,
  ntree_moderate = 50,
  base_moderate  = 0.25,
  power_moderate = 3
)

bcf_sensitivity <- list(
  ntree_control = 200,
  base_control  = 0.95,
  power_control = 2,
  ntree_moderate = 200,
  base_moderate  = 0.95,
  power_moderate = 2
)

#############################
# 5. BCF fit function
#############################

fit_bcf <- function(data, pars,
                    outcome, treat, covars,
                    nburn = 2000, nsim = 5000) {
  
  y <- data[[outcome]]
  z <- data[[treat]]
  X <- as.matrix(dplyr::select(data, all_of(covars)))
  
  pihat <- rep(mean(z), nrow(data))  # cleaner than hard-coded 2/3
  
  bcf(
    y = y,
    z = z,
    x_control = X,
    x_moderate = X,
    pihat = pihat,
    nburn = nburn,
    nsim = nsim,
    ntree_control = pars$ntree_control,
    base_control = pars$base_control,
    power_control = pars$power_control,
    ntree_moderate = pars$ntree_moderate,
    base_moderate = pars$base_moderate,
    power_moderate = pars$power_moderate
  )
}

#############################
# 6. Fit models across imputations
#############################

fit_all_imputations <- function(imp_list, pars) {
  lapply(imp_list, fit_bcf,
         pars = pars,
         outcome = outcome,
         treat = treat,
         covars = covars)
}

bcf_primary_models <- fit_all_imputations(imp_list, bcf_primary)
bcf_sensitivity_models <- fit_all_imputations(imp_list, bcf_sensitivity)

#############################
# 7. Extract posterior tau
#############################

extract_tau <- function(fit) fit$tau

tau_list <- lapply(bcf_primary_models, extract_tau)

pooled_tau <- do.call(rbind, tau_list)

#############################
# 8. Overall treatment effect
#############################

ate_draws <- rowMeans(pooled_tau)

overall_ate <- mean(ate_draws)
ate_ci <- quantile(ate_draws, c(0.025, 0.975))
p_gt_zero <- mean(ate_draws > 0)

cat("\nATE:", overall_ate, "\n")
print(ate_ci)
cat("\nP(ATE > 0):", p_gt_zero, "\n")

#############################
# 9. Subject-level CATE
#############################

cate <- colMeans(pooled_tau)

#############################
# 10. Subgroup helper
#############################

subgroup_effect <- function(idx, label1, label2) {
  
  g1 <- apply(pooled_tau[, idx[[1]]], 1, mean)
  g2 <- apply(pooled_tau[, idx[[2]]], 1, mean)
  
  diff <- g1 - g2
  
  tibble(
    group1 = label1,
    group2 = label2,
    mean = mean(diff),
    lo = quantile(diff, 0.025),
    hi = quantile(diff, 0.975),
    p_gt_0 = mean(diff > 0)
  )
}

#############################
# 11. Subgroup analyses
#############################

analysis_df <- imp_list[[1]]

# Sex
sex_idx <- list(
  male = which(analysis_df$sex == "Male"),
  female = which(analysis_df$sex == "Female")
)

sex_res <- subgroup_effect(sex_idx, "Male", "Female")

# Age
age_idx <- list(
  young = which(analysis_df$age < 60),
  old   = which(analysis_df$age >= 60)
)

age_res <- subgroup_effect(age_idx, "<60", ">=60")

#############################
# 12. Density plot
#############################

plot_df <- tibble(
  male = apply(pooled_tau[, sex_idx$male], 1, mean),
  female = apply(pooled_tau[, sex_idx$female], 1, mean)
) %>%
  pivot_longer(everything(), names_to = "group", values_to = "value")

ggplot(plot_df, aes(value, fill = group)) +
  geom_density(alpha = 0.4) +
  theme_bw()

#############################
# 13. CART for subgroup discovery
#############################

cart_df <- analysis_df
cart_df$cate <- cate

form <- as.formula(
  paste("cate ~", paste(covars, collapse = " + "))
)

cart_fit <- rpart(
  form,
  data = cart_df,
  method = "anova",
  control = rpart.control(cp = 0.01,
                          minbucket = 20,
                          maxdepth = 3)
)

rpart.plot(cart_fit, type = 3, extra = 101)

#############################
# 14. Terminal node subgroup effects
#############################

nodes <- cart_fit$where

cart_df$node <- nodes

node_results <- lapply(unique(nodes), function(n) {
  
  idx <- which(nodes == n)
  
  draw <- apply(pooled_tau[, idx], 1, mean)
  
  tibble(
    node = n,
    mean = mean(draw),
    lo = quantile(draw, 0.025),
    hi = quantile(draw, 0.975),
    p_gt_0 = mean(draw > 0)
  )
}) %>% bind_rows()

#############################
# 15. Save
#############################

write.csv(node_results, "subgroup_results.csv", row.names = FALSE)

saveRDS(bcf_primary_models, "bcf_models.rds")
saveRDS(pooled_tau, "pooled_tau.rds")
